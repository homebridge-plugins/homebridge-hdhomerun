  "author": "homebridge-plugins",
  "license": "MIT",
  "homepage": "https://github.com/homebridge-plugins/homebridge-hdhomerun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge-plugins/homebridge-hdhomerun.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-hdhomerun/issues"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "supports-hap",
    "supports-matter",
    "homebridge-hdhomerun",
    "homekit",
