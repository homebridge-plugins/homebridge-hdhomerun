    "silicondust",
    "tv tuner",
    "channels dvr",
    "energy"
  ],
  "main": "lib/index.js",
  "engines": {
    "homebridge": "^1.11.4 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
